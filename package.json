{
  "name": "pss-console",
  "version": "1.1.0",
  "description": "PS5-style Windows console launcher",
  "author": "PSS",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-setup.ps1",
    "smoke": "node tests/smoke.cjs",
    "package:app": "electron-builder --win dir --x64",
    "assets:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-assets.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "local.pss.console",
    "productName": "PSS Console",
    "directories": {
      "output": "../PSS-Builds"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.ico",
      "assets/tray.png"
    ],
    "extraResources": [
      {
        "from": "native/publish",
        "to": "helper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    }
  }
}
