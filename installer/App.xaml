<Application x:Class="PssSetup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="TextBrush" Color="#EEEEF0"/><SolidColorBrush x:Key="MutedBrush" Color="#B2B2BC"/>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="pack://application:,,,/PssSetup;component/Brand/Fonts/#SST Light"/><Setter Property="FontSize" Value="53"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="LineHeight" Value="62"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EEEEF0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#55EEEEF0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="27,12"/><Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="28" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#28FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F5F5F7"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#F6F6F8"/></MultiTrigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#ECECEF"/><Setter Property="Foreground" Value="#17181B"/><Setter Property="BorderBrush" Value="#ECECEF"/><Setter Property="MinWidth" Value="210"/><Setter Property="Tag" Value="primary"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="19"/><Setter Property="Foreground" Value="#F1F1F3"/><Setter Property="Background" Value="#15161B"/><Setter Property="BorderBrush" Value="#65BDBDC6"/><Setter Property="Padding" Value="16,15"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#707078"/></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#EEEEF1"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" BorderBrush="#8CDEDEE4" BorderThickness="1" CornerRadius="4" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontSize="19" TextAlignment="Center" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#33DEDEE4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F9F9FB"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
