<Window x:Class="PssSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PSS Console Setup" Width="1280" Height="760" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#17181C" FontFamily="pack://application:,,,/PssSetup;component/Brand/Fonts/#SST" Foreground="#EEEEF0" PreviewKeyDown="OnKeyDown" PreviewMouseDown="OnPointer" GotKeyboardFocus="OnFocus" Closing="OnClosing">
 <Border BorderBrush="#55C4C4CC" BorderThickness="1" ClipToBounds="True"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
  <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#121317" Offset="0"/><GradientStop Color="#35363B" Offset="0.7"/><GradientStop Color="#202126" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False" Opacity="0.26"><Canvas Width="1280" Height="760"><Path Data="M 1300,-190 C 1600,100 940,590 510,330 C 230,160 850,-100 1300,-190" Stroke="#B9BBC4" StrokeThickness="0.7"/><Path Data="M 1390,-220 C 1670,70 1020,640 530,375 C 210,190 880,-140 1390,-220" Stroke="#A3A5AE" StrokeThickness="0.45"/></Canvas></Viewbox>
  <Grid Grid.Row="0" Margin="46,0,32,0" MouseLeftButtonDown="OnDrag"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PSS" FontSize="26" FontWeight="Medium"/><Border Background="#55D8D8DF" Width="1" Height="18" Margin="23,0"/><TextBlock x:Name="HeaderLabel" Text="CONSOLE SETUP" FontSize="12" Foreground="#B4B5BF" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Padding="16,4" BorderThickness="0" Click="Minimize" AutomationProperties.Name="Minimize"/><Button x:Name="CloseButton" Content="×" FontSize="27" Padding="14,2" BorderThickness="0" Click="CloseSetup" AutomationProperties.Name="Close setup"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="88,8,88,0" x:Name="Scene">
   <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820">
    <Viewbox Width="118" Height="72" Margin="0,0,0,38"><Canvas Width="140" Height="80"><Path Data="M 28,17 Q70,4 112,17 Q126,28 132,65 Q132,79 119,75 L96,55 L44,55 L21,75 Q7,79 8,65 Q14,28 28,17Z" Stroke="#E7E7EC" StrokeThickness="1.8"/><Path Data="M 35,24 L35,45 M24,35 L46,35" Stroke="#E7E7EC" StrokeThickness="2"/><Ellipse Width="7" Height="7" Stroke="#E7E7EC" Canvas.Left="101" Canvas.Top="22"/><Ellipse Width="7" Height="7" Stroke="#E7E7EC" Canvas.Left="112" Canvas.Top="33"/><Ellipse Width="7" Height="7" Stroke="#E7E7EC" Canvas.Left="90" Canvas.Top="33"/><Ellipse Width="7" Height="7" Stroke="#E7E7EC" Canvas.Left="101" Canvas.Top="44"/></Canvas></Viewbox>
    <TextBlock Text="Welcome to PSS." FontSize="68" FontFamily="pack://application:,,,/PssSetup;component/Brand/Fonts/#SST Light" TextAlignment="Center"/>
    <TextBlock Text="Your PC. A new way to play." FontSize="25" Foreground="#CACAD2" TextAlignment="Center" Margin="0,20,0,0"/>
    <TextBlock Text="Games, entertainment, and the web. Together." FontSize="17" Foreground="#A6A7B2" TextAlignment="Center" Margin="0,18,0,0"/>
   </StackPanel>
   <StackPanel x:Name="LocationPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Choose your space." Style="{StaticResource Heading}"/><TextBlock Text="Where should your console live?" Foreground="#C1C1CB" Margin="0,0,0,36"/><TextBlock Text="INSTALL LOCATION" FontSize="12" Foreground="#B0B0BC" Margin="0,0,0,12"/><TextBox x:Name="DestinationBox" MinWidth="750"/><TextBlock x:Name="StorageText" FontSize="16" Foreground="#ABABB7" Margin="0,18,0,0"/><TextBlock Text="Your games and Windows desktop stay right where they are." FontSize="17" Foreground="#B9B9C5" Margin="0,32,0,0"/></StackPanel>
   <StackPanel x:Name="PreferencesPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="930" HorizontalAlignment="Left"><TextBlock Text="Make it yours." Style="{StaticResource Heading}"/><TextBlock Text="A few details before you start." Foreground="#C1C1CB" Margin="0,0,0,30"/><CheckBox x:Name="StartupCheck" IsChecked="True" Content="Open console when I sign in to Windows"/><CheckBox x:Name="ShortcutCheck" IsChecked="True" Content="Add a desktop shortcut"/><CheckBox x:Name="SoundCheck" IsChecked="True" Content="Play PS5 interface sounds"/><CheckBox x:Name="MotionCheck" Content="Reduce interface motion"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Jellyfin server" FontSize="17" Foreground="#BDBDC7" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="JellyfinBox" Text="http://127.0.0.1:8096" MinWidth="430" FontSize="17" Padding="13,10"/></Grid><TextBlock Text="Browser: Windows default. Your current accounts stay signed in." FontSize="16" Foreground="#AFAFBB" Margin="0,22,0,0"/></StackPanel>
   <StackPanel x:Name="ReviewPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Ready when you are." Style="{StaticResource Heading}"/><TextBlock Text="Your console is one step away." Foreground="#C1C1CB" Margin="0,0,0,34"/><TextBlock x:Name="ReviewText" FontSize="20" LineHeight="35"/><TextBlock Text="Updating PSS will close its launcher. Your games and browser stay open." FontSize="16" Foreground="#ADADBA" Margin="0,28,0,0"/></StackPanel>
   <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="920" HorizontalAlignment="Stretch"><TextBlock x:Name="ProgressHeading" Text="Getting everything ready." Style="{StaticResource Heading}"/><TextBlock x:Name="ProgressLabel" Text="Preparing your console…" Foreground="#C1C1CC" Margin="0,0,0,44"/><Grid Height="5" Background="#33DCDCE4"><Border x:Name="ProgressFill" Background="#E9E9EF" HorizontalAlignment="Left" Width="0"/></Grid><Grid Margin="0,22,0,0"><TextBlock x:Name="PercentText" Text="0%" FontSize="17" Foreground="#CFCFD8"/><TextBlock Text="Please keep this window open." FontSize="16" Foreground="#A6A6B3" HorizontalAlignment="Right"/></Grid></StackPanel>
   <StackPanel x:Name="CompletePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900"><Border Width="78" Height="78" BorderBrush="#E5E5EC" BorderThickness="1.5" CornerRadius="39" Margin="0,0,0,28"><TextBlock Text="✓" FontSize="39" TextAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="CompleteHeading" Text="Welcome to your console." FontSize="54" FontFamily="pack://application:,,,/PssSetup;component/Brand/Fonts/#SST Light" TextAlignment="Center"/><TextBlock x:Name="CompleteText" Text="You're all set. Your next adventure awaits." FontSize="23" Foreground="#CACAD5" Margin="0,20,0,0" TextAlignment="Center"/><TextBlock Text="Ctrl + Alt + D returns to Windows anytime." FontSize="16" Foreground="#A9A9B8" Margin="0,28,0,0" TextAlignment="Center"/></StackPanel>
   <StackPanel x:Name="UninstallPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="900"><TextBlock Text="Back to your desktop." Style="{StaticResource Heading}"/><TextBlock Text="Remove PSS Console from this PC?" Foreground="#C7C7D0" Margin="0,0,0,32"/><CheckBox x:Name="KeepDataCheck" IsChecked="True" Content="Keep my collection and settings for later"/><TextBlock Text="Your games, browser accounts, media, and Windows desktop stay untouched." FontSize="18" Foreground="#B1B1BE" Margin="0,22,0,0"/></StackPanel>
   <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="920"><TextBlock Text="Let's try that again." Style="{StaticResource Heading}"/><TextBlock x:Name="ErrorIntro" Text="Setup couldn't finish. Your existing installation is preserved." FontSize="22" Foreground="#C5C5CE" Margin="0,0,0,24"/><TextBlock x:Name="ErrorText" FontSize="17" Foreground="#D5BDB7" LineHeight="26"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="62,0,62,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackButton" Content="Back" BorderThickness="0" Click="GoBack"/><TextBlock x:Name="StepText" Text="01 / 06" FontSize="13" Foreground="#9C9CAA" VerticalAlignment="Center" Margin="20,0,0,0"/><TextBlock x:Name="FooterHint" Text="ENTER  Continue     ESC  Back" FontSize="12" Foreground="#8F8F9E" VerticalAlignment="Center" Margin="36,0,0,0"/></StackPanel><Button Grid.Column="1" x:Name="NextButton" Content="Get started" Style="{StaticResource PrimaryButton}" Click="GoNext" VerticalAlignment="Center"/></Grid>
 </Grid></Border>
</Window>
